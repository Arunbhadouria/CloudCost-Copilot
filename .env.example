# Database connection string (PostgreSQL for Docker, or SQLite for local dev)
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/cloudcost

# Google Gemini API configuration
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# LLM mode: 'mock' for local tests/demo without API keys, 'live' for real Gemini calls
LLM_MODE=mock

# Default random seed for synthetic data generation
DEFAULT_SEED=1

